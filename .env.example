# Copy to .env on the VM and fill in. Never commit .env.
DB_PASSWORD=change-me-long-random
ADMIN_TOKEN=change-me-admin-secret
TOKEN_SECRET=change-me-another-long-random
# Hostname that points at the VM's public IP. With no domain, use sslip.io:
# for Elastic IP 13.232.10.20 -> 13-232-10-20.sslip.io
DOMAIN=13-232-10-20.sslip.io
# Optional: larger heap on a 2 GB instance
# JAVA_TOOL_OPTIONS=-Xmx900m -XX:+UseSerialGC -Xss512k -XX:TieredStopAtLevel=1
